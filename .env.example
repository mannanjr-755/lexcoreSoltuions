# Copy to .env.local and fill in real values. Never commit .env or .env.local.

# Neon pooled URL (host contains -pooler). Optional query params (auto-added if omitted):
# connection_limit=1 (serverless) or 10 (local), pool_timeout=30-60, pgbouncer=true, statement_cache_size=0
DATABASE_URL=
DIRECT_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_OTP_SECRET=

APP_URL=

SUPER_ADMIN_EMAIL=admin@lexcore.com
# Deprecated for passwords — use AUTH_PASSWORD_ADMIN instead.
# If set to the old shared value Lexcore@2026!, it is ignored.
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Admin

# Per-user passwords for authorized Lexcore accounts (min 8 chars).
# Defaults (if unset): Admin@Lexcore1!, Abdul@Lexcore1!, Raid@Lexcore1!, Yousuf@Lexcore1!, Anjasha@Lexcore1!
# Do NOT use the old shared password Lexcore@2026! — it is migrated away automatically.
AUTH_PASSWORD_ADMIN=
AUTH_PASSWORD_ABDUL=
AUTH_PASSWORD_RAID=
AUTH_PASSWORD_YOUSUF=
AUTH_PASSWORD_ANJASHA=

# Set true once to re-apply seed passwords to existing authorized users, then remove.
# AUTHORIZED_USERS_SYNC_PASSWORDS=true

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
